---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div style="display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0;">
    <button id="enviar" style="padding: 20px 40px; font-size: 18px; cursor: pointer; background-color: #007bff; color: white; border: none; border-radius: 8px;">
      Enviar mensaje MQTT
    </button>
  </div>

  <script>
    const btn = document.getElementById('enviar');
    btn.addEventListener('click', async () => {
      const response = await fetch('http://127.0.0.1:8000/mqtt/publicar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mensaje: 'Hola desde el frontend' })
      });
      const data = await response.json();
      alert('Respuesta: ' + JSON.stringify(data));
    });
  </script>
</Layout>